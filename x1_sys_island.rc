#include <windows.h>
#include "resource.h"

#define APP_VERSION_MAJOR 0
#define APP_VERSION_MINOR 8
#define APP_VERSION_PATCH 3
#define APP_VERSION_BUILD 0
#define STRINGIFY_IMPL(value) #value
#define STRINGIFY(value) STRINGIFY_IMPL(value)
#define APP_VERSION STRINGIFY(APP_VERSION_MAJOR.APP_VERSION_MINOR.APP_VERSION_PATCH)
#define APP_FILE_VERSION STRINGIFY(APP_VERSION_MAJOR.APP_VERSION_MINOR.APP_VERSION_PATCH.APP_VERSION_BUILD)
#define ABOUT_VERSION_IMPL(major,minor,patch) STRINGIFY(X1 SYS Island v##major.minor.patch)
#define ABOUT_VERSION(major,minor,patch) ABOUT_VERSION_IMPL(major,minor,patch)
#define APP_ABOUT_VERSION ABOUT_VERSION(APP_VERSION_MAJOR,APP_VERSION_MINOR,APP_VERSION_PATCH)
#define APP_VERSION_NUMERIC APP_VERSION_MAJOR,APP_VERSION_MINOR,APP_VERSION_PATCH,APP_VERSION_BUILD

IDB_INTEL_LOGO BITMAP "assets/intel_logo.bmp"
IDB_3S_LOGO BITMAP "assets/3s_logo_about.bmp"

IDD_ABOUT_DIALOG DIALOGEX 0, 0, 205, 128
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About X1 SYS Island"
FONT 9, "Segoe UI"
BEGIN
    CONTROL         "",IDC_ABOUT_LOGO,"Static",
                    SS_BITMAP | SS_CENTERIMAGE,10,5,185,43
    LTEXT           APP_ABOUT_VERSION,IDC_ABOUT_VERSION,
                    8,48,189,11,SS_CENTER
    LTEXT           "Intel CPU, RAM and iGPU Monitor",IDC_ABOUT_SUBTITLE,
                    8,61,189,10,SS_CENTER
    LTEXT           "Developed with Codex and Curiosity",IDC_ABOUT_TITLE,
                    8,74,189,10,SS_CENTER
    LTEXT           "by nghia.td@3si.vn @2026-09",IDC_ABOUT_CREDIT,
                    8,87,189,10,SS_CENTER
    DEFPUSHBUTTON   "OK",IDOK,78,104,49,16
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION APP_VERSION_NUMERIC
 PRODUCTVERSION APP_VERSION_NUMERIC
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "3S Intersoft JSC"
            VALUE "FileDescription", "X1 SYS Island"
            VALUE "FileVersion", APP_FILE_VERSION
            VALUE "InternalName", "X1-SYS-Island"
            VALUE "LegalCopyright", "Developed with Codex and Curiosity"
            VALUE "OriginalFilename", "X1-SYS-Island.exe"
            VALUE "ProductName", "X1 SYS Island"
            VALUE "ProductVersion", APP_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END


